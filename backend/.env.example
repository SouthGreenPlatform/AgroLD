DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=*

SPARQL_ENDPOINT=https://sparql.southgreen.fr/sparql/
FACETED_SEARCH_URL=https://sparql.southgreen.fr/fct/
RF_LINK=http://rf.southgreen.fr/
AGROLD_INSTANCE=
API_VERSION=3.0.0
SPARQL_QUERY_TIMEOUT=20

EUROPEPMC_SERVICE_URL=https://www.ebi.ac.uk/europepmc/webservices/rest/search
GRAMENE_GENES_URL=http://data.gramene.org/v58/genes

# CORS_ALLOWED_ORIGINS only matters if CORS_ALLOW_ALL_ORIGINS=false — this
# API serves public, read-only, unauthenticated data (same as the original
# app), so allow-all is the default. Set it to false and list explicit
# origins here instead if you need to lock this down.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173
CORS_ALLOW_ALL_ORIGINS=true

# LLM chat feature (src/views/ChatPage.vue -> POST /api/llm/)
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5
